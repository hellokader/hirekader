# Site URL
NEXT_PUBLIC_SITE_URL=https://hirekader.com

# Server Port
PORT=3000

# SMTP Configuration (for contact form emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
CONTACT_RECEIVER_EMAIL=abdul@hirekader.com

# Cloudflare Turnstile (optional - for spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Google Tag Manager (optional)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Meta Pixel (optional)
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# Microsoft Clarity (optional)
NEXT_PUBLIC_CLARITY_ID=XXXXXXXXXX

# WordPress CMS Integration (optional - for blog)
WORDPRESS_API_URL=https://cms.hirekader.com
